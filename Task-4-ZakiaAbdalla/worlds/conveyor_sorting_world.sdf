<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="conveyor_sorting_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Sim Core Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light Source -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.25 0.3 1</ambient>
            <diffuse>0.2 0.25 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Focused Camera GUI Setup -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.1 -1.6 1.15 0 0.45 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Conveyor Belt Assembly -->
    <model name="conveyor_belt">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <!-- Main Frame -->
      <link name="conveyor_base">
        <visual name="visual_frame">
          <geometry>
            <box>
              <size>2.5 0.4 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.55 1</ambient>
            <diffuse>0.15 0.35 0.55 1</diffuse>
          </material>
        </visual>
        <collision name="collision_frame">
          <geometry>
            <box>
              <size>2.5 0.4 0.1</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Conveyor Legs -->
      <link name="leg1">
        <pose>-1.0 0 -0.2 0 0 0</pose>
        <visual name="v_leg1">
          <geometry><box><size>0.08 0.35 0.4</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
      </link>
      <link name="leg2">
        <pose>1.0 0 -0.2 0 0 0</pose>
        <visual name="v_leg2">
          <geometry><box><size>0.08 0.35 0.4</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
      </link>

      <!-- Optical Proximity Sensor (%I0.1) -->
      <link name="sensor_prox_link">
        <pose>-0.8 0.22 0.15 0 0 0</pose>
        <visual name="sensor_prox_vis">
          <geometry><box><size>0.04 0.04 0.08</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient></material>
        </visual>
      </link>

      <!-- Height Optical Sensor (%I0.4) -->
      <link name="sensor_tall_link">
        <pose>-0.5 0.22 0.2 0 0 0</pose>
        <visual name="sensor_tall_vis">
          <geometry><box><size>0.04 0.04 0.08</size></box></geometry>
          <material><ambient>0.0 0.8 1.0 1</ambient></material>
        </visual>
        <sensor name="height_laser" type="gpu_ray">
          <pose>0 0 0 0 0 -1.57</pose>
          <ray>
            <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
            <range><min>0.05</min><max>0.5</max></range>
          </ray>
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Pneumatic Reject Pusher Mount (%Q1.1) -->
      <link name="pusher_mount">
        <pose>0.25 0.28 0.1 0 0 0</pose>
        <visual name="pusher_mount_vis">
          <geometry><box><size>0.12 0.12 0.15</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient></material>
        </visual>
      </link>

      <!-- Reject Bin -->
      <link name="reject_bin">
        <pose>0.25 -0.4 0.2 0 0 0</pose>
        <visual name="bin_vis">
          <geometry><box><size>0.4 0.35 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Tall Box Workpiece (Item to be rejected) -->
    <model name="tall_box">
      <pose>-0.5 0 0.55 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.005</iyy><iyz>0</iyz>
            <izz>0.005</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.25</size></box></geometry>
          <material>
            <ambient>1.0 0.5 0.0 1</ambient>
            <diffuse>1.0 0.5 0.0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.25</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
